{
  "release-type": "rust",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "changelog-type": "default",
  "pull-request-title-pattern": "release: ${version}",
  "pull-request-header": "🚀 Automated Release PR",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "✨ Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "🐛 Bug Fixes",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "⚡ Performance",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "♻️ Refactoring",
      "hidden": false
    },
    {
      "type": "revert",
      "section": "⏪ Reverts",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "📚 Documentation",
      "hidden": false
    },
    {
      "type": "deps",
      "section": "📦 Dependencies",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "🤖 CI/CD",
      "hidden": true
    },
    {
      "type": "test",
      "section": "🧪 Tests",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "🔧 Maintenance",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "rust"
    }
  }
}
